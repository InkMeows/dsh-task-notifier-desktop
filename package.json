{
  "name": "@dsh-external/dsh-task-notifier-desktop",
  "version": "0.2.1-desktop.1",
  "description": "Codex-style system notifications for the DSH Desktop app (dsh 0.2.1-rc.1): OS toasts when a task finishes or the model asks for your input (question / approval / plan review). Version-isolated twin of @dsh-external/dsh-task-notifier.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "notification",
    "desktop-notification",
    "task",
    "desktop"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "semver": "^7.8.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config-loader native",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/run-all.mjs",
    "verify": "node tests/desktop-verify.mjs",
    "wiring": "node scripts/profile-wiring.mjs --check",
    "pack": "npm pack"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}