# npm: peers here are supplied by the DSH runtime, never by the package manager.
legacy-peer-deps=true
# pnpm: do not try to fetch @deepseek-ai/dsh-* peers from the registry — the DSH
# profile/app provides them at runtime, and the desktop peer ranges point at a
# version that is not published as a standalone installable dependency here.
auto-install-peers=false
strict-peer-dependencies=false